PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://bursaros_user:your_password@localhost:5432/bursaros?schema=public"
DIRECT_URL="postgresql://bursaros_user:your_password@localhost:5432/bursaros"

# Dedicated Isolated Test Database (Required for running automated tests)
# Must NEVER point to the same database as DATABASE_URL or DIRECT_URL
TEST_DATABASE_URL="postgresql://bursaros_user:your_password@localhost:5432/bursaros_test"

# Payment Provider Configuration: MOCK or PAYSTACK
PAYMENT_PROVIDER=MOCK
PAYSTACK_SECRET_KEY=sk_test_mock_secret_key_12345

# JWT Secret Configuration (Minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
